# Copy to .env and edit. Never commit .env.
GOOGLE_MAPS_API_KEY=
# demo = built-in deterministic DEMO facility generator (default, works offline)
# overpass = live OpenStreetMap POIs (internet needed; the model must then be trained on data built the same way)
FACILITY_SOURCE=demo
# 1 = use OpenStreetMap Nominatim for search/reverse geocoding when the local gazetteer has no match
ONLINE_GEOCODING=1
DATABASE_PATH=database/property.db
# Optional: if set, admin write actions need header X-Admin-Token (or the token field on /admin)
ADMIN_TOKEN=
FLASK_DEBUG=0
http://127.0.0.1:5001